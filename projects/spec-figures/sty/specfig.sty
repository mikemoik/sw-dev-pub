% =============================================================================
%  specfig.sty -- common figures for specifications and project manuals
%
%  Every figure is an environment sf<Type> whose body holds plain data
%  commands (one command = one element). specfig computes the layout and draws
%  a TikZ picture; problems (unknown IDs, bad dates, ...) are listed in red
%  under the figure and given as LaTeX warnings. The data commands exist only
%  inside their environment, so they never clash with a document's own
%  commands of the same name (\Milestone, \Risk, ...).
%
%  This file: common core + UML and block diagrams (sequence, state machine,
%  activity, flowchart, use case, class, component, deployment, package,
%  block/context). Planning figures: specfig-plan.sty, charts:
%  specfig-chart.sty (both loaded here).
%
%  Written for TeX Live 2022 and newer (LaTeX 2022-06, L3 2022-02-24,
%  pgf 3.1.9a): no newer expl3 functions, no packages outside TeX Live.
%  See README.md for the command reference. MIT license (repo root).
% =============================================================================
\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesPackage{specfig}[2026/11/17 v0.1 Figures for specifications and project manuals]

\RequirePackage{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,calc,fit,backgrounds,shapes.geometric,shapes.multipart,shapes.misc}

