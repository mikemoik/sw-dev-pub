% edge options
\tl_new:N \l__sf_route_tl
\tl_new:N \l__sf_bend_tl
\tl_new:N \l__sf_mfrom_tl
\tl_new:N \l__sf_mto_tl
\tl_new:N \l__sf_lpos_tl
\keys_define:nn { specfig/edge }
  {
    hv     .code:n = { \tl_set:Nn \l__sf_route_tl { hv } } ,
    vh     .code:n = { \tl_set:Nn \l__sf_route_tl { vh } } ,
    left   .code:n = { \tl_set:Nn \l__sf_route_tl { bend } \tl_set:Nn \l__sf_bend_tl { left } } ,
    right  .code:n = { \tl_set:Nn \l__sf_route_tl { bend } \tl_set:Nn \l__sf_bend_tl { right } } ,
    m1     .tl_set:N = \l__sf_mfrom_tl ,
    m2     .tl_set:N = \l__sf_mto_tl ,
    pos    .tl_set:N = \l__sf_lpos_tl ,
    unknown .code:n = { \sf_problem:x { unknown~connection~option~`\l_keys_key_str' } } ,
  }
\tl_new:N \l__sf_from_tl
\tl_new:N \l__sf_to_tl
\bool_new:N \l__sf_ok_bool
% \l__sf_tmp_tl := node name of ID #1, or the bool is cleared (+ problem #2)
\cs_new_protected:Npn \__sf_lookup:nn #1#2
  {
    \prop_get:NnNTF \g__sf_id_prop {#1} \l__sf_tmp_tl
      { \tl_set:Nx \l__sf_tmp_tl { sfn \l__sf_tmp_tl } }
      { \bool_set_false:N \l__sf_ok_bool \sf_problem:n { unknown~ID~#1~(#2) } }
  }
\cs_new_protected:Npn \__sf_draw_edge:nnnnn #1#2#3#4#5   % kind options from to label
  {
    \group_begin:
    \tl_clear:N \l__sf_route_tl
    \tl_clear:N \l__sf_mfrom_tl
    \tl_clear:N \l__sf_mto_tl
    \tl_set:Nn \l__sf_lpos_tl { 0.5 }
    \keys_set:nn { specfig/edge } {#2}
    \bool_set_true:N \l__sf_ok_bool
    \__sf_lookup:nn {#3} { #3~->~#4 }
    \tl_set_eq:NN \l__sf_from_tl \l__sf_tmp_tl
    \__sf_lookup:nn {#4} { #3~->~#4 }
    \tl_set_eq:NN \l__sf_to_tl \l__sf_tmp_tl
    \bool_if:NT \l__sf_ok_bool
      {
        \tl_if_eq:NNT \l__sf_from_tl \l__sf_to_tl { \tl_set:Nn \l__sf_route_tl { loop } }
        \str_case:VnF \l__sf_route_tl
          {
            { hv }
              {
                \tl_set:Nn \l__sf_lpos_tl { 0.25 }
                \__sf_edge_path:nnnn {#1} { -| } {#5} { }
              }
            { vh }
              {
                \tl_set:Nn \l__sf_lpos_tl { 0.25 }
                \__sf_edge_path:nnnn {#1} { |- } {#5} { }
              }
            { bend }
              { \__sf_edge_path:nnnn {#1} { to } {#5} { bend~\l__sf_bend_tl = 25 } }
            { loop }
              { \__sf_edge_path:nnnn {#1} { to } {#5} { loop~above , min~distance=8mm } }
          }
          { \__sf_edge_path:nnnn {#1} { -- } {#5} { } }
      }
    \group_end:
  }
\cs_new_protected:Npn \__sf_edge_path:nnnn #1#2#3#4   % kind path-op label to-options
  {
    \use:x
      {
        \exp_not:N \draw [ sf/#1 ] ( \l__sf_from_tl ) #2
        \tl_if_blank:nF {#4} { [ #4 ] }
        \tl_if_empty:NF \l__sf_mfrom_tl
          { node [ sf/mlabel , pos = 0.1 , auto ] { \exp_not:V \l__sf_mfrom_tl } }
        \tl_if_empty:NF \l__sf_mto_tl
          { node [ sf/mlabel , pos = 0.9 , auto ] { \exp_not:V \l__sf_mto_tl } }
        \tl_if_blank:nF {#3}
          { node [ sf/elabel , pos = \l__sf_lpos_tl ] { \exp_not:n {#3} } }
        ( \l__sf_to_tl ) ;
      }
  }
\cs_generate_variant:Nn \str_case:nnF { V }

\tl_new:N \l__sf_fit_tl
\int_new:N \g__sf_group_int
\cs_new_protected:Npn \__sf_draw_group:nnn #1#2#3   % kind label IDs
  {
    \tl_clear:N \l__sf_fit_tl
    \clist_map_inline:nn {#3}
      {
        \bool_set_true:N \l__sf_ok_bool
