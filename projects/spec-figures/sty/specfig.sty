\ExplSyntaxOn
% =============================================================================
%  Core: options, problems, dates
% =============================================================================
\tl_new:N \g__sf_type_tl                 % name of the figure being built
\seq_new:N \g__sf_problems_seq
\msg_new:nnn { specfig } { problem } { #2:~#1 }

% sf_problem:n {text}: listed in red under the current figure + LaTeX warning
\cs_new_protected:Npn \sf_problem:n #1
  {
    \seq_gput_right:Nn \g__sf_problems_seq {#1}
    \use:x
      {
        \exp_not:N \msg_warning:nnnn { specfig } { problem }
          { \tl_to_str:n {#1} } { \tl_use:N \g__sf_type_tl }
      }
  }
\cs_generate_variant:Nn \sf_problem:n { x }
% inside a tikzpicture: the problems as a red node under the picture
\cs_new_protected:Npn \sf_problems_draw:
  {
    \seq_if_empty:NF \g__sf_problems_seq
      {
        \node [ sf/problems ] at ( $ (current~bounding~box.south~west) + (0,-0.15cm) $ )
          { \seq_use:Nn \g__sf_problems_seq { \\ } } ;
      }
    \seq_gclear:N \g__sf_problems_seq
  }

% options of all figures (each figure uses the ones it needs)
\dim_new:N \l_sf_xstep_dim
\dim_new:N \l_sf_ystep_dim
\dim_new:N \l_sf_step_dim
\dim_new:N \l_sf_width_dim
\dim_new:N \l_sf_height_dim
\int_new:N \l_sf_levels_int
\tl_new:N \l_sf_xlabel_tl
\tl_new:N \l_sf_ylabel_tl
\tl_new:N \l_sf_today_tl
\keys_define:nn { specfig }
  {
    xstep   .dim_set:N = \l_sf_xstep_dim ,   % grid: column distance
    ystep   .dim_set:N = \l_sf_ystep_dim ,   % grid: row distance
    step    .dim_set:N = \l_sf_step_dim ,    % sequence / timing: row height
    width   .dim_set:N = \l_sf_width_dim ,   % Gantt, timeline, charts
    height  .dim_set:N = \l_sf_height_dim ,  % charts
    levels  .int_set:N = \l_sf_levels_int ,  % risk matrix: 3, 4 or 5
    xlabel  .tl_set:N  = \l_sf_xlabel_tl ,
    ylabel  .tl_set:N  = \l_sf_ylabel_tl ,
    today   .tl_set:N  = \l_sf_today_tl ,    % Gantt / timeline: "today" line
    unknown .code:n    = { \sf_problem:x { unknown~option~`\l_keys_key_str' } } ,
  }
% sf_begin:nnn {figure name}{defaults}{user options}
\cs_new_protected:Npn \sf_begin:nnn #1#2#3
  {
    \tl_gset:Nn \g__sf_type_tl {#1}
    \seq_gclear:N \g__sf_problems_seq
    \keys_set:nn { specfig }
      { xstep = 3.6cm , ystep = 1.8cm , step = 0.75cm , width = 14cm , height = 6cm ,
        levels = 5 , xlabel = {} , ylabel = {} , today = {} , #2 }
    \keys_set:nn { specfig } {#3}
    \sf_graph_clear:
  }

% ---- dates: \sf_day:nN {YYYY-MM-DD} \int  (day number; F branch: not a date)
\seq_new:N \l__sf_date_seq
\prg_new_protected_conditional:Npnn \sf_day:nN #1#2 { T , F , TF }
  {
    \regex_extract_once:nnNTF { \A \s* (\d{4}) - (\d{1,2}) - (\d{1,2}) \s* \Z }
      {#1} \l__sf_date_seq
      {
        \bool_lazy_and:nnTF
          { \int_compare_p:nNn { \seq_item:Nn \l__sf_date_seq { 3 } } < { 13 } }
          {
            \bool_lazy_and_p:nn
              { \int_compare_p:nNn { \seq_item:Nn \l__sf_date_seq { 3 } } > { 0 } }
              {
                \bool_lazy_and_p:nn
                  { \int_compare_p:nNn { \seq_item:Nn \l__sf_date_seq { 4 } } > { 0 } }
                  { \int_compare_p:nNn { \seq_item:Nn \l__sf_date_seq { 4 } } < { 32 } }
              }
          }
          {
            \__sf_jdn:nnnN
              { \seq_item:Nn \l__sf_date_seq { 2 } }
              { \seq_item:Nn \l__sf_date_seq { 3 } }
              { \seq_item:Nn \l__sf_date_seq { 4 } } #2
            \prg_return_true:
          }
          { \prg_return_false: }
      }
      { \prg_return_false: }
  }
\cs_generate_variant:Nn \sf_day:nN { V }
\cs_generate_variant:Nn \sf_day:nNT { V }
\cs_generate_variant:Nn \sf_day:nNF { V }
\cs_generate_variant:Nn \sf_day:nNTF { V }
% Julian day number of y m d (proleptic Gregorian)
\int_new:N \l__sf_a_int
\int_new:N \l__sf_y_int
\int_new:N \l__sf_m_int
\cs_new_protected:Npn \__sf_jdn:nnnN #1#2#3#4
  {
    \int_set:Nn \l__sf_a_int { \int_div_truncate:nn { 14 - (#2) } { 12 } }
    \int_set:Nn \l__sf_y_int { (#1) + 4800 - \l__sf_a_int }
    \int_set:Nn \l__sf_m_int { (#2) + 12 * \l__sf_a_int - 3 }
    \int_set:Nn #4
      {
        (#3) + \int_div_truncate:nn { 153 * \l__sf_m_int + 2 } { 5 }
        + 365 * \l__sf_y_int + \int_div_truncate:nn { \l__sf_y_int } { 4 }
        - \int_div_truncate:nn { \l__sf_y_int } { 100 }
        + \int_div_truncate:nn { \l__sf_y_int } { 400 } - 32045
      }
  }
% \sf_date_from_day:nN {day number} \tl -> YYYY-MM-DD (inverse of \sf_day:nN)
\int_new:N \l__sf_b_int
\int_new:N \l__sf_c_int
\int_new:N \l__sf_d_int
\int_new:N \l__sf_e_int
\cs_new_protected:Npn \sf_date_from_day:nN #1#2
  {
    \int_set:Nn \l__sf_a_int { (#1) + 32044 }
    \int_set:Nn \l__sf_b_int { \int_div_truncate:nn { 4 * \l__sf_a_int + 3 } { 146097 } }
    \int_set:Nn \l__sf_c_int { \l__sf_a_int - \int_div_truncate:nn { 146097 * \l__sf_b_int } { 4 } }
    \int_set:Nn \l__sf_d_int { \int_div_truncate:nn { 4 * \l__sf_c_int + 3 } { 1461 } }
    \int_set:Nn \l__sf_e_int { \l__sf_c_int - \int_div_truncate:nn { 1461 * \l__sf_d_int } { 4 } }
    \int_set:Nn \l__sf_m_int { \int_div_truncate:nn { 5 * \l__sf_e_int + 2 } { 153 } }
    \tl_set:Nx #2
      {
        \int_eval:n { 100 * \l__sf_b_int + \l__sf_d_int - 4800
                      + \int_div_truncate:nn { \l__sf_m_int } { 10 } }
        -
        \int_compare:nNnT { \l__sf_m_int + 3 - 12 * \int_div_truncate:nn { \l__sf_m_int } { 10 } } < { 10 } { 0 }
        \int_eval:n { \l__sf_m_int + 3 - 12 * \int_div_truncate:nn { \l__sf_m_int } { 10 } }
        -
        \int_compare:nNnT
          { \l__sf_e_int - \int_div_truncate:nn { 153 * \l__sf_m_int + 2 } { 5 } + 1 } < { 10 } { 0 }
        \int_eval:n { \l__sf_e_int - \int_div_truncate:nn { 153 * \l__sf_m_int + 2 } { 5 } + 1 }
      }
  }

% is #1 a number (int or decimal, optional sign)?
\prg_new_protected_conditional:Npnn \sf_if_number:n #1 { T , F , TF }
  {
    \regex_match:nnTF { \A \s* [+\-]? (\d+ (\.\d*)? | \.\d+) \s* \Z } {#1}
      { \prg_return_true: } { \prg_return_false: }
  }

% =============================================================================
%  Graph engine: elements on a grid, connections between them
%
%  An element has a kind (its TikZ style sf/<kind>, or a drawer
%  \__sf_draw_<kind>:nnnnn), an ID, a grid position [column,row] and a label.
%  Without a position it goes next to the previous element of its lane
%  (to the right or below, per lane). Connections refer to IDs; unknown IDs
%  become problems. Node names are sfn<index>, so IDs may hold any character.
% =============================================================================
\prop_new:N \g__sf_id_prop               % ID -> index
\seq_new:N \g__sf_nodes_seq              % {index}{kind}{col}{row}{label}
\seq_new:N \g__sf_edges_seq              % {kind}{options}{from}{to}{label}
\seq_new:N \g__sf_groups_seq             % {kind}{label}{IDs}
\prop_new:N \g__sf_extra_prop            % index -> extra lines (attributes, ...)
\prop_new:N \g__sf_extra_b_prop          % index -> second extra block (operations)
\prop_new:N \g__sf_lane_prop             % lane -> {col}{row}{dir}
\int_new:N \g__sf_n_int
\tl_new:N \g__sf_last_tl                 % index of the last element
\tl_new:N \l__sf_c_tl
\tl_new:N \l__sf_r_tl
\tl_new:N \l__sf_dir_tl
\tl_new:N \l__sf_tmp_tl
\tl_new:N \l__sf_a_tl
\tl_new:N \l__sf_b_tl
\seq_new:N \l__sf_pos_seq

\cs_new_protected:Npn \sf_graph_clear:
  {
    \prop_gclear:N \g__sf_id_prop
    \seq_gclear:N \g__sf_nodes_seq
    \seq_gclear:N \g__sf_edges_seq
    \seq_gclear:N \g__sf_groups_seq
    \prop_gclear:N \g__sf_extra_prop
    \prop_gclear:N \g__sf_extra_b_prop
    \prop_gclear:N \g__sf_lane_prop
    \int_gzero:N \g__sf_n_int
    \tl_gclear:N \g__sf_last_tl
  }
% \sf_lane:nnnnn {lane}{first col}{first row}{right|down}{step}
\cs_new_protected:Npn \sf_lane:nnnnn #1#2#3#4#5
  { \prop_gput:Nnn \g__sf_lane_prop {#1} { {#2} {#3} {#4} {#5} } }
\cs_new_protected:Npn \__sf_lane_get:n #1
  {
    \prop_get:NnNF \g__sf_lane_prop {#1} \l__sf_tmp_tl
      { \tl_set:Nn \l__sf_tmp_tl { {0} {0} {right} {1} } }
    \tl_set:Nx \l__sf_c_tl { \tl_item:Nn \l__sf_tmp_tl { 1 } }
    \tl_set:Nx \l__sf_r_tl { \tl_item:Nn \l__sf_tmp_tl { 2 } }
    \tl_set:Nx \l__sf_dir_tl { \tl_item:Nn \l__sf_tmp_tl { 3 } }
    \tl_set:Nx \l__sf_step_tl { \tl_item:Nn \l__sf_tmp_tl { 4 } }
  }
\tl_new:N \l__sf_step_tl
% \sf_node:nnnnn {kind}{lane}{position "c,r" or empty}{ID}{label}
\cs_new_protected:Npn \sf_node:nnnnn #1#2#3#4#5
  {
    \__sf_lane_get:n {#2}
    \tl_if_blank:nF {#3}
      {
        \regex_match:nnTF
          { \A \s* [+\-]? (\d+(\.\d*)?|\.\d+) \s* , \s* [+\-]? (\d+(\.\d*)?|\.\d+) \s* \Z } {#3}
          {
            \seq_set_split:Nnn \l__sf_pos_seq { , } {#3}
            \tl_set:Nx \l__sf_c_tl { \seq_item:Nn \l__sf_pos_seq { 1 } }
            \tl_set:Nx \l__sf_r_tl { \seq_item:Nn \l__sf_pos_seq { 2 } }
          }
          { \sf_problem:n { #4:~position~[#3]~is~not~[column,row] } }
      }
    \int_gincr:N \g__sf_n_int
    \tl_gset:Nx \g__sf_last_tl { \int_use:N \g__sf_n_int }
    \tl_if_blank:nF {#4}
      {
        \prop_if_in:NnTF \g__sf_id_prop {#4}
          { \sf_problem:n { duplicate~ID~#4 } }
          { \prop_gput:NnV \g__sf_id_prop {#4} \g__sf_last_tl }
      }
    \seq_gput_right:Nx \g__sf_nodes_seq
      { { \g__sf_last_tl } {#1} { \l__sf_c_tl } { \l__sf_r_tl } { \exp_not:n {#5} } }
    % next element of this lane: right of / below this one
    \str_if_eq:VnTF \l__sf_dir_tl { down }
      { \tl_set:Nx \l__sf_r_tl { \fp_eval:n { \l__sf_r_tl + \l__sf_step_tl } } }
      { \tl_set:Nx \l__sf_c_tl { \fp_eval:n { \l__sf_c_tl + \l__sf_step_tl } } }
    \prop_gput:Nnx \g__sf_lane_prop {#2}
      { { \l__sf_c_tl } { \l__sf_r_tl } { \l__sf_dir_tl } { \l__sf_step_tl } }
  }
% extra lines of the last element (attributes, artifacts, ...): a = first block
\cs_new_protected:Npn \sf_extra:nn #1#2   % {a|b}{line}
  {
    \tl_if_empty:NTF \g__sf_last_tl
      { \sf_problem:n { `#2'~comes~before~any~element } }
      {
        \tl_set:Nx \l__sf_a_tl { \str_if_eq:nnTF {#1} { a } { g__sf_extra_prop } { g__sf_extra_b_prop } }
        \prop_get:cVNTF { \l__sf_a_tl } \g__sf_last_tl \l__sf_tmp_tl
          { \tl_put_right:Nn \l__sf_tmp_tl { \\ #2 } }
          { \tl_set:Nn \l__sf_tmp_tl {#2} }
        \prop_gput:cVV { \l__sf_a_tl } \g__sf_last_tl \l__sf_tmp_tl
      }
  }
\cs_generate_variant:Nn \prop_get:NnNTF { cVNTF }
\cs_generate_variant:Nn \prop_gput:Nnn { cVV }
% \sf_edge:nnnnn {kind}{options}{from ID}{to ID}{label}
\cs_new_protected:Npn \sf_edge:nnnnn #1#2#3#4#5
  { \seq_gput_right:Nn \g__sf_edges_seq { {#1} {#2} {#3} {#4} {#5} } }
% \sf_group:nnn {kind}{label}{IDs, comma-separated}
\cs_new_protected:Npn \sf_group:nnn #1#2#3
  { \seq_gput_right:Nn \g__sf_groups_seq { {#1} {#2} {#3} } }

% ---- drawing ---------------------------------------------------------------
\tl_new:N \l__sf_x_tl
\tl_new:N \l__sf_y_tl
\cs_new_protected:Npn \sf_graph_draw:
  {
    \seq_map_inline:Nn \g__sf_nodes_seq { \__sf_draw_node:nnnnn ##1 }
