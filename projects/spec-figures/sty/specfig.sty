                \tl_set:Nx \l__sf_b_tl { \tl_item:Nn \l__sf_tmp_tl { 3 } }
                \tl_if_blank:VF \l__sf_b_tl
                  { \node [ sf/guard ] at ( sffl.north~east ) { [ \l__sf_b_tl ] } ; }
