        \bool_if:NT \l__sf_ok_bool { \tl_put_right:Nx \l__sf_fit_tl { ( \l__sf_tmp_tl ) } }
      }
    \tl_if_empty:NF \l__sf_fit_tl
      {
        \int_gincr:N \g__sf_group_int
        \begin{pgfonlayer}{background}
          \use:x
            {
              \exp_not:N \node [ sf/#1 , fit = \l__sf_fit_tl ]
                ( sfg \int_use:N \g__sf_group_int ) { } ;
            }
        \end{pgfonlayer}
        \tl_if_blank:nF {#2}
          { \node [ sf/glabel ] at ( sfg \int_use:N \g__sf_group_int .north~west ) {#2} ; }
      }
  }

