      \fp_set:Nn \l__sf_seq_xmax_fp
        { ( \seq_count:N \g__sf_seq_parts_seq - 1 ) * \dim_to_fp:n { \l_sf_xstep_dim } }
      \fp_set:Nn \l__sf_seq_y_fp { -1.1 }
      \seq_map_inline:Nn \g__sf_seq_events_seq { \__sf_seq_event:nnnn ##1 }
      \seq_if_empty:NF \l__sf_frag_seq
        {
          \sf_problem:n { Fragment~without~EndFragment }
          \bool_do_until:nn { \seq_if_empty_p:N \l__sf_frag_seq } { \__sf_seq_event:nnnn { endfrag } { } { } { } }
        }
      % lifelines down to the last event
      \fp_sub:Nn \l__sf_seq_y_fp { 0.3 }
      \prop_map_inline:Nn \l__sf_seq_x_prop
        {
          \draw [ sf/lifeline ] ( ##2 pt , -0.45cm )
            -- ( ##2 pt , \fp_to_decimal:N \l__sf_seq_y_fp cm ) ;
        }
