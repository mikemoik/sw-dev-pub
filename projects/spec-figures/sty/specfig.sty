\cs_new_protected:Npn \__sf_seq_part:nnnn #1#2#3#4   % n ID label kind
  {
    \tl_set:Nx \l__sf_x_tl { \fp_eval:n { (#1 - 1) * \dim_to_fp:n { \l_sf_xstep_dim } } }
    \prop_if_in:NnTF \l__sf_seq_x_prop {#2}
      { \sf_problem:n { duplicate~participant~#2 } }
      { \prop_put:NnV \l__sf_seq_x_prop {#2} \l__sf_x_tl }
    \str_if_eq:nnTF {#4} { actor }
      {
        \node [ sf/actor , anchor = south ] ( sfp#1 ) at ( \l__sf_x_tl pt , -0.05cm ) { } ;
        \node [ sf/actorlabel , anchor = south ] at ( \l__sf_x_tl pt , 1.15cm ) {#3} ;
      }
      { \node [ sf/participant , anchor = north ] at ( \l__sf_x_tl pt , 0.4cm ) {#3} ; }
