  }
\cs_new_protected:Npn \__sf_seq_step:n #1   % y -= #1 * step
  { \fp_sub:Nn \l__sf_seq_y_fp { #1 * \dim_to_fp:n { \l_sf_step_dim } / 28.45274 } }
\cs_new_protected:Npn \__sf_seq_event:nnnn #1#2#3#4   % type a b label
  {
    \tl_set:Nx \l__sf_y_tl { \fp_to_decimal:N \l__sf_seq_y_fp cm }
    \bool_set_true:N \l__sf_ok_bool
    \str_case:nn {#1}
      {
        { msg }     { \__sf_seq_arrow:nnnn { msg } {#2} {#3} {#4} }
        { async }   { \__sf_seq_arrow:nnnn { async } {#2} {#3} {#4} }
        { reply }   { \__sf_seq_arrow:nnnn { reply } {#2} {#3} {#4} }
        { self }
          {
            \__sf_seq_x:nN {#2} \l__sf_xa_tl
            \bool_if:NT \l__sf_ok_bool
              {
                \draw [ sf/msg ] ( \l__sf_xa_tl pt , \l__sf_y_tl ) -- ++ ( 0.6cm , 0 )
                  -- ++ ( 0 , -0.35cm ) -- ++ ( -0.6cm , 0 ) ;
                \node [ sf/msglabel , anchor = west ]
                  at ( \l__sf_xa_tl pt + 0.65cm , \l__sf_y_tl - 0.17cm ) {#4} ;
              }
            \__sf_seq_step:n { 1.5 }
