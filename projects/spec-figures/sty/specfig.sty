                \tl_set:Nx \l__sf_a_tl { \tl_item:Nn \l__sf_tmp_tl { 1 } cm }
                \draw [ sf/fragment ] ( \l__sf_xa_tl , \l__sf_a_tl ) rectangle ( \l__sf_xb_tl , \l__sf_y_tl ) ;
                \node [ sf/fraglabel ] ( sffl ) at ( \l__sf_xa_tl , \l__sf_a_tl )
