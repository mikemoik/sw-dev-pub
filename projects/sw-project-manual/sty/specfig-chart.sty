    \seq_gclear:N \g__sf_chart_series_seq
    \seq_gclear:N \g__sf_chart_bars_seq
    \seq_gclear:N \g__sf_chart_thr_seq
    \DeclareDocumentCommand \Categories { m } { \clist_gset:Nn \g__sf_chart_cats_clist {##1} }
