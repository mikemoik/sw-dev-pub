\cs_new:Npn \__sf_chart_y:n #1   % value -> y in cm
  {
    \fp_eval:n
      { ( (#1) - \l__sf_chart_lo_fp ) / ( \l__sf_chart_hi_fp - \l__sf_chart_lo_fp ) * \l__sf_chart_h_fp }
  }
\cs_new:Npn \__sf_chart_colour:n #1 { sfc \int_eval:n { \int_mod:nn { #1 - 1 } { 6 } + 1 } }

\cs_new_protected:Npn \__sf_chart_draw:
  {
    % \Bar data become one unnamed series
    \seq_if_empty:NF \g__sf_chart_bars_seq
      {
        \seq_if_empty:NTF \g__sf_chart_series_seq
          {
            \clist_gclear:N \g__sf_chart_cats_clist
            \tl_clear:N \l__sf_chart_a_tl
            \seq_map_inline:Nn \g__sf_chart_bars_seq { \__sf_chart_bar_data:nn ##1 }
            \seq_gput_right:Nx \g__sf_chart_series_seq { { } { \exp_not:V \l__sf_chart_a_tl } }
          }
          { \sf_problem:n { use~either~Bar~or~Series~and~Categories;~Bar~lines~ignored } }
      }
    \int_set:Nn \l__sf_chart_n_int { \clist_count:N \g__sf_chart_cats_clist }
    \int_set:Nn \l__sf_chart_m_int { \seq_count:N \g__sf_chart_series_seq }
    \int_compare:nNnT \l__sf_chart_n_int = { 0 }
      { \sf_problem:n { no~categories } }
    \int_compare:nNnT \l__sf_chart_m_int > { 6 }
      { \sf_problem:n { more~than~6~series:~colours~repeat } }
    % value range: all valid values, thresholds and 0
    \fp_zero:N \l__sf_chart_lo_fp
    \fp_zero:N \l__sf_chart_hi_fp
    \seq_map_inline:Nn \g__sf_chart_series_seq { \__sf_chart_check:nn ##1 }
    \seq_map_inline:Nn \g__sf_chart_thr_seq { \__sf_chart_range_thr:nn ##1 }
    \__sf_chart_nice:
    \fp_set:Nn \l__sf_chart_w_fp { \__sf_chart_cm:n { \l_sf_width_dim } }
    \fp_set:Nn \l__sf_chart_h_fp { \__sf_chart_cm:n { \l_sf_height_dim } }
    \fp_set:Nn \l__sf_chart_slot_fp { \l__sf_chart_w_fp / max ( 1 , \l__sf_chart_n_int ) }
    \fp_set:Nn \l__sf_chart_base_fp
      { \__sf_chart_y:n { max ( \l__sf_chart_lo_fp , min ( 0 , \l__sf_chart_hi_fp ) ) } }
    \begin{tikzpicture}
      % grid and tick labels
      \int_step_inline:nnn { 0 }
        { \fp_eval:n { round ( ( \l__sf_chart_hi_fp - \l__sf_chart_lo_fp ) / \l__sf_chart_step_fp ) } }
        {
          \tl_set:Nx \l__sf_chart_a_tl
            { \fp_eval:n { round ( \l__sf_chart_lo_fp + ##1 * \l__sf_chart_step_fp , 6 ) } }
          \tl_set:Nx \l__sf_chart_b_tl { \__sf_chart_y:n { \l__sf_chart_a_tl } }
          \draw [ sfc/ygrid ] ( 0 , \l__sf_chart_b_tl cm )
            -- ( \fp_eval:n { \l__sf_chart_w_fp } cm , \l__sf_chart_b_tl cm ) ;
          \node [ sfc/tick ] at ( -0.05cm , \l__sf_chart_b_tl cm ) { \l__sf_chart_a_tl } ;
        }
      % data
      \int_zero:N \l__sf_chart_s_int
      \seq_map_inline:Nn \g__sf_chart_series_seq
        {
          \int_incr:N \l__sf_chart_s_int
          \use:c { __sf_chart_ \g__sf_chart_kind_tl :nn } ##1
        }
      % thresholds
      \seq_map_inline:Nn \g__sf_chart_thr_seq { \__sf_chart_thr:nn ##1 }
      % axes
      \draw [ sfc/axis ] ( 0 , 0 ) -- ( 0 , \fp_eval:n { \l__sf_chart_h_fp } cm ) ;
      \draw [ sfc/axis ] ( 0 , \fp_eval:n { \l__sf_chart_base_fp } cm )
        -- ( \fp_eval:n { \l__sf_chart_w_fp } cm , \fp_eval:n { \l__sf_chart_base_fp } cm ) ;
      % category labels
      \int_zero:N \l__sf_chart_s_int
      \clist_map_inline:Nn \g__sf_chart_cats_clist
        {
          \int_incr:N \l__sf_chart_s_int
          \node [ sfc/cat , text~width = \fp_eval:n { max ( 0.5 , \l__sf_chart_slot_fp - 0.1 ) } cm ]
            at ( \fp_eval:n { ( \l__sf_chart_s_int - 0.5 ) * \l__sf_chart_slot_fp } cm , -0.05cm ) {##1} ;
        }
      % axis titles
      \tl_if_blank:VF \l_sf_xlabel_tl
        {
          \__sf_chart_bbox:nN { south } \l__sf_chart_b_tl
          \node [ sfc/title , anchor = north ]
            at ( \fp_eval:n { \l__sf_chart_w_fp / 2 } cm , \l__sf_chart_b_tl cm ) { \l_sf_xlabel_tl } ;
        }
      \tl_if_blank:VF \l_sf_ylabel_tl
        {
          \__sf_chart_bbox:nN { west } \l__sf_chart_b_tl
          \node [ sfc/title , anchor = south , rotate = 90 ]
            at ( \l__sf_chart_b_tl cm , \fp_eval:n { \l__sf_chart_h_fp / 2 } cm ) { \l_sf_ylabel_tl } ;
        }
      % legend
      \int_compare:nNnT \l__sf_chart_m_int > { 1 }
        {
          \tl_clear:N \l__sf_chart_txt_tl
          \int_zero:N \l__sf_chart_s_int
          \seq_map_inline:Nn \g__sf_chart_series_seq { \__sf_chart_legend:nn ##1 }
          \__sf_chart_bbox:nN { south } \l__sf_chart_b_tl
          \node [ sfc/legend , anchor = north ]
            at ( \fp_eval:n { \l__sf_chart_w_fp / 2 } cm , \fp_eval:n { \l__sf_chart_b_tl - 0.15 } cm )
            { \l__sf_chart_txt_tl } ;
        }
      \sf_problems_draw:
    \end{tikzpicture}
  }
\cs_generate_variant:Nn \tl_if_blank:nF { V }
\cs_new_protected:Npn \__sf_chart_bar_data:nn #1#2
  {
    \clist_gput_right:Nn \g__sf_chart_cats_clist { {#1} }
    \tl_if_empty:NF \l__sf_chart_a_tl { \tl_put_right:Nn \l__sf_chart_a_tl { , } }
    \tl_put_right:Nn \l__sf_chart_a_tl {#2}
  }
% checks one series, widens the value range
\cs_new_protected:Npn \__sf_chart_check:nn #1#2
  {
    \clist_set:Nn \l__sf_chart_vals_clist {#2}
    \int_compare:nNnF { \clist_count:N \l__sf_chart_vals_clist } = \l__sf_chart_n_int
      {
        \sf_problem:x
          {
            series~`\tl_to_str:n {#1}':~\clist_count:N \l__sf_chart_vals_clist \c_space_tl
            values~for~\int_use:N \l__sf_chart_n_int \c_space_tl categories
          }
      }
    \clist_map_inline:Nn \l__sf_chart_vals_clist
      {
        \sf_if_number:nTF {##1}
          {
            \fp_set:Nn \l__sf_chart_lo_fp { min ( \l__sf_chart_lo_fp , ##1 ) }
            \fp_set:Nn \l__sf_chart_hi_fp { max ( \l__sf_chart_hi_fp , ##1 ) }
          }
          {
            \sf_problem:x
              { series~`\tl_to_str:n {#1}':~value~`\tl_to_str:n {##1}'~is~not~a~number }
          }
      }
  }
\cs_new_protected:Npn \__sf_chart_range_thr:nn #1#2
  {
    \sf_if_number:nTF {#1}
      {
        \fp_set:Nn \l__sf_chart_lo_fp { min ( \l__sf_chart_lo_fp , #1 ) }
        \fp_set:Nn \l__sf_chart_hi_fp { max ( \l__sf_chart_hi_fp , #1 ) }
      }
      { \sf_problem:x { threshold~`\tl_to_str:n {#1}'~is~not~a~number } }
  }
% axis from a multiple of a nice step (1, 2, 5 x 10^k, about 5 ticks)
\fp_new:N \l__sf_chart_raw_fp
\fp_new:N \l__sf_chart_mag_fp
\cs_new_protected:Npn \__sf_chart_nice:
  {
    \fp_compare:nNnT { \l__sf_chart_hi_fp - \l__sf_chart_lo_fp } = { 0 }
      { \fp_set:Nn \l__sf_chart_hi_fp { \l__sf_chart_lo_fp + 1 } }
    \fp_set:Nn \l__sf_chart_raw_fp { ( \l__sf_chart_hi_fp - \l__sf_chart_lo_fp ) / 5 }
    \fp_set:Nn \l__sf_chart_mag_fp
      { 10 ^ ( floor ( ln ( \l__sf_chart_raw_fp ) / ln ( 10 ) ) ) }
    \fp_set:Nn \l__sf_chart_raw_fp { \l__sf_chart_raw_fp / \l__sf_chart_mag_fp }
    \fp_set:Nn \l__sf_chart_step_fp
      {
        \l__sf_chart_mag_fp *
        ( \l__sf_chart_raw_fp <= 1.0000001 ? 1 :
          ( \l__sf_chart_raw_fp <= 2.0000001 ? 2 :
            ( \l__sf_chart_raw_fp <= 5.0000001 ? 5 : 10 ) ) )
      }
    \fp_set:Nn \l__sf_chart_lo_fp
      { floor ( \l__sf_chart_lo_fp / \l__sf_chart_step_fp ) * \l__sf_chart_step_fp }
    \fp_set:Nn \l__sf_chart_hi_fp
      { ceil ( \l__sf_chart_hi_fp / \l__sf_chart_step_fp ) * \l__sf_chart_step_fp }
  }
% bars of series number \l__sf_chart_s_int
\cs_new_protected:Npn \__sf_chart_bar:nn #1#2
  {
    \clist_set:Nn \l__sf_chart_vals_clist {#2}
    \tl_set:Nx \l__sf_chart_d_tl { \fp_eval:n { 0.72 * \l__sf_chart_slot_fp / \l__sf_chart_m_int } }
    \int_step_inline:nn { \int_min:nn { \clist_count:N \l__sf_chart_vals_clist } { \l__sf_chart_n_int } }
      {
        \tl_set:Nx \l__sf_chart_c_tl { \clist_item:Nn \l__sf_chart_vals_clist {##1} }
        \exp_args:NV \sf_if_number:nT \l__sf_chart_c_tl
          {
            \tl_set:Nx \l__sf_chart_a_tl
              {
                \fp_eval:n
                  { (##1 - 1) * \l__sf_chart_slot_fp + 0.14 * \l__sf_chart_slot_fp
                    + ( \l__sf_chart_s_int - 1 ) * \l__sf_chart_d_tl }
              }
            \tl_set:Nx \l__sf_chart_b_tl { \__sf_chart_y:n { \l__sf_chart_c_tl } }
            \tl_set:Nx \l__sf_chart_txt_tl { \__sf_chart_colour:n { \l__sf_chart_s_int } }
            \fill [ fill = \l__sf_chart_txt_tl ]
              ( \l__sf_chart_a_tl cm , \fp_eval:n { \l__sf_chart_base_fp } cm )
