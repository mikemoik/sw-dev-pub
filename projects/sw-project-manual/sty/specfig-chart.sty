\clist_new:N \g__sf_chart_cats_clist
\seq_new:N \g__sf_chart_series_seq       % {name}{v1, v2, ...}
\seq_new:N \g__sf_chart_bars_seq         % {label}{value}
\seq_new:N \g__sf_chart_thr_seq          % {value}{label}
